void parpadeo( int r,int g,int b, int t ) //parametros
{
  //validaciones
  if((r >1 || r <0) || (g >1 || g <0) || (b >1 || b<0) )
   return;
   
  digitalWrite(LED_R,r);
  digitalWrite(LED_G,g);
  digitalWrite(LED_B,b);
   delay( t );
  digitalWrite(LED_R,LOW);
  digitalWrite(LED_G,LOW);
  digitalWrite(LED_B,LOW);
   delay( t );
}


//funcion
float obtenerTemp()
{
  float temp = (analogRead(TMP) * 5.0 /1024) *100 -50;
 
  return temp;
  //return (analogRead(TMP) * 5.0 /1024) *100 -50;
}

float convertirTemp(float t, char opt)
{
  float temp=0;
  switch(opt)
  {
    case 'f':
        temp = (t * (9/5)) + 32;
    break;
    case 'k':
        temp = t + 237.0;
    break;
    default:
        temp = t;
  }
  return temp;
}

int* vectorAleatorio()
