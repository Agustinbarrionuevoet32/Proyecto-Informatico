}

void vaciarVec( int* v , int size)
{
  for(int i =0 ; i < size ; i++)
  {
    v[i] = 0;
  }
}

void vaciarVec()
{
  for(int i =0 ; i < lenght(aux,int) ; i++)
  {
    aux[i] = 0;
  }  
}


//procedimiento
void tocarCancion(int b)
{
  if( thisnote < notes * 2)
  {
    if(millis() - timerMelodia >= noteDuration )
    {
      timerMelodia = millis();
      noTone(b);
     
      divider = melodia[thisnote+1];
     
      if(divider > 0){
        //duracin normal de una nota
          noteDuration = wholenote / divider ;
      }else if(divider < 0){
        //incremento TEMPORAL de una nota
          noteDuration = wholenote / abs(divider) ;
        noteDuration *= mod;
      }
      tone(b , melodia[thisnote] , noteDuration *0.9 );
      thisnote = thisnote + 2;
    }
  } else {
    noTone(b);
  }
}
